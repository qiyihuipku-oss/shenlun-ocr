{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shenlun-ocr",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
